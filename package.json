{
    "name": "sohl-thalorna",
    "private": true,
    "productName": "Thalorna Setting",
    "description": "Items, Actors, Journals, Scenes, and other assets to enable play in the Thalorna setting for Song of Heroic Lands",
    "version": "0.0.1",
    "author": {
        "name": "Tom Rodriguez",
        "email": "toasty@heroiclands.org",
        "url": "https://www.heroiclands.org"
    },
    "x-contact": {
        "discord": "toasty#8538",
        "bluesky": "@toasty.heroiclands.org"
    },
    "homepage": "https://www.heroicland.org",
    "license": "GPL-3.0-or-later AND CC-BY-SA-4.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/HeroicLands/sohl-thalorna"
    },
    "bugs": "https://github.com/HeroicLands/sohl-thalorna/issues",
    "engines": {
        "node": ">=24.0.0"
    },
    "type": "module",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "clean": "package-build clean",
        "distclean": "package-build clean --distclean",
        "build": "npm ci && npm run build:noci",
        "build:local": "npm i && npm run build:noci",
        "build:noci": "run-s format:check lint build:prepare build:code build:link-manifest",
        "build:prepare": "run-p build:db build:system",
        "build:code": "vite build",
        "build:db": "run-s build:assets build:compiledb",
        "build:system": "package-build manifest",
        "build:assets": "package-build assets",
        "build:compiledb": "content-build package compile",
        "build:unpackdb": "content-build package unpack",
        "build:link-manifest": "content-build manifest",
        "lint": "run-s lint:format lint:markdown lint:addresses lint:content-links",
        "lint:format": "content-build format",
        "lint:markdown": "content-build markdown",
        "lint:markdown:fix": "content-build markdown --fix",
        "lint:content-links": "content-build links",
        "lint:addresses": "content-build lint",
        "build:site-content": "node utils/build-site-content.mjs",
        "build:site": "run-s build:site-content build:site-html build:site-root",
        "build:site-html": "hugo --source site --minify --gc --cleanDestinationDir",
        "build:site-root": "node utils/build-site-root.mjs",
        "serve:site": "npm run build:site-content && hugo server --source site",
        "build:pack-release": "package-build release",
        "push:dev": "package-build deploy dev",
        "push:qa": "package-build deploy qa",
        "push:prod": "package-build deploy prod",
        "push:local-dev": "npm run push:qa",
        "deploy:local": "npm run deploy:qa",
        "deploy:qa": "run-s build push:qa",
        "deploy:dev": "run-s build push:dev",
        "deploy:prod": "run-s build push:prod",
        "deploy:release": "run-s build build:pack-release",
        "format": "content-build format --write",
        "format:check": "content-build format",
        "changeset": "changeset",
        "changeset:version": "changeset version && npm install --package-lock-only",
        "changeset:check": "changeset status --since=origin/main"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.1",
        "@heroiclands/content-build": "^1.7.0",
        "@heroiclands/hugo-theme": "^0.1.2",
        "@heroiclands/package-build": "^0.6.0",
        "@rollup/plugin-terser": "^0.4.4",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "vite": "^8.2.2",
        "yaml": "^2.9.0"
    }
}
